# 复制为 .env 并修改真实值
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=movie_seckill
MYSQL_USER=root
MYSQL_PASSWORD=root123

# JWT 签名密钥（生产环境务必改成随机长串）
JWT_SECRET=movie-seckill-prod-secret-change-me-32bytes-minimum

# 对外端口
HTTP_PORT=8088

# Docker 构建时 npm 源（国内网络建议走淘宝）
NPM_REGISTRY=https://registry.npmmirror.com/
