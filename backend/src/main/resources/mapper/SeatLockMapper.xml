<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wangning.seckill.mapper.SeatLockMapper">

    <!--
      查某场次未释放的座位（status != 0），用于前端座位图渲染。
      面试点：唯一索引 uk_seat(schedule_id,row_num,col_num) 是第三层防重售。
    -->
    <select id="selectActiveBySchedule" resultType="com.wangning.seckill.entity.SeatLock">
        SELECT id, schedule_id, row_num, col_num, user_id, order_no, status
        FROM seat_lock
        WHERE schedule_id = #{scheduleId}
          AND status != 0
    </select>

    <!--
      查找超时未释放的座位锁（关单兜底用）。
    -->
    <select id="selectExpiredLocks" resultType="com.wangning.seckill.entity.SeatLock">
        SELECT id, schedule_id, row_num, col_num, user_id, lock_token, order_no
        FROM seat_lock
        WHERE status = 1
          AND lock_until &lt; NOW()
        LIMIT 50
    </select>

</mapper>
